<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LifeOS — আপনার জীবন, আপনার নিয়ন্ত্রণে</title>
    <meta name="description" content="পার্সোনাল লাইফ অপারেটিং সিস্টেম: আর্থিক হিসাব, অ্যাকাউন্ট, অভ্যাস, রুটিন, টাস্ক এবং দীর্ঘমেয়াদী লক্ষ্য।">

    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">

    <!-- Kalpurush Bangla Font & Google Fonts -->
    <link rel="stylesheet" href="https://fonts.maateen.me/kalpurush/font.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.7/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/assets/css/styles.css" asp-append-version="true">
</head>
<body>
    @RenderBody()

    <!-- ========================================================================
         EXTERNAL LIBRARIES VIA CDN
         ======================================================================== -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.7/dist/sweetalert2.all.min.js"></script>

    <!-- ========================================================================
         APPLICATION MODULES
         ======================================================================== -->
    <script src="~/assets/js/mock-data.js" asp-append-version="true"></script>
    <script src="~/assets/js/utils.js" asp-append-version="true"></script>
    <script src="~/assets/js/storage.js" asp-append-version="true"></script>
    <script src="~/assets/js/api-client.js" asp-append-version="true"></script>
    <script src="~/assets/js/three-scene.js" asp-append-version="true"></script>
    <script src="~/assets/js/charts.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/auth.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/dashboard.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/myday.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/calendar.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/transactions.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/accounts.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/conveyance.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/budgets.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/savings.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/habits.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/tasks.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/routines.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/lifegoals.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/journal.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/analytics.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/search.js" asp-append-version="true"></script>
    <script src="~/assets/js/modules/settings.js" asp-append-version="true"></script>
    <script src="~/assets/js/app.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
