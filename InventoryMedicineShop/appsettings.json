{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MediShopInventoryDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "ProductionConnection": "Server=your-production-server;Database=MediShopInventoryDB;User Id=your-user;Password=your-password;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=False"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5000",
    "http://localhost:5173",
    "https://localhost:5001"
  ],

  "AppSettings": {
    "ShopName": "MediShop Inventory",
    "Currency": "USD",
    "CurrencySymbol": "$",
    "TaxRate": 0.0,
    "LowStockThreshold": 50,
    "ReorderPoint": 20,
    "ExpiryAlertDays": 90,
    "CriticalExpiryDays": 30,
    "EnableLowStockAlerts": true,
    "EnableExpiryAlerts": true,
    "EnableEmailNotifications": false,
    "MaxFailedLoginAttempts": 5,
    "AccountLockoutMinutes": 30,
    "PasswordResetTokenExpiryHours": 24
  },

  "Authentication": {
    "EnableAuthentication": true,
    "RequireEmailVerification": false,
    "PasswordRequirements": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "MinimumLength": 8
    }
  },

  "JWT": {
    "SecretKey": "YourSuperSecretKeyForJWTTokenGeneration-ChangeThisInProduction-MustBe256BitsOrMore",
    "Issuer": "MediShopAPI",
    "Audience": "MediShopClients",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "MediShop Inventory",
    "SenderEmail": "noreply@medishop.com",
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "EnableSsl": true
  },

  "BackupSettings": {
    "EnableAutoBackup": true,
    "BackupIntervalHours": 24,
    "BackupPath": "C:\\Backups\\MediShopDB",
    "RetentionDays": 30
  },

  "ReportSettings": {
    "DefaultPageSize": 50,
    "MaxPageSize": 1000,
    "EnablePdfExport": true,
    "EnableExcelExport": true,
    "DefaultDateRange": 30
  },

  "CacheSettings": {
    "EnableCaching": true,
    "DefaultCacheMinutes": 10,
    "DashboardCacheMinutes": 5,
    "ReportCacheMinutes": 15
  },

  "BatchManagement": {
    "EnableFEFO": true,
    "AllowManualBatchSelection": false,
    "WarnOnNearExpiry": true,
    "BlockExpiredBatchSales": true,
    "AutoUpdateBatchStatus": true
  },

  "InventorySettings": {
    "AllowNegativeStock": false,
    "RequireBatchNumber": true,
    "RequireExpiryDate": true,
    "RequireSupplier": true,
    "AutoCalculateSellingPrice": false,
    "DefaultProfitMarginPercentage": 30
  },

  "SalesSettings": {
    "AllowCreditSales": false,
    "RequireCustomerInfo": false,
    "RequirePrescription": false,
    "AllowRefunds": true,
    "RefundTimeLimit Days": 7,
    "GenerateInvoice": true,
    "PrintReceiptAfterSale": true
  },

  "SecuritySettings": {
    "EnableAuditLog": true,
    "LogUserActions": true,
    "EnableIPWhitelist": false,
    "AllowedIPAddresses": [],
    "SessionTimeoutMinutes": 120,
    "EnableTwoFactorAuth": false
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "RequestHeadersTimeout": "00:01:00"
    }
  }
}
