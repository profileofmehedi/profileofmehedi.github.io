[Unit]
Description=Asper AI Banking Service
After=network.target

[Service]
Type=notify
User=www-data
WorkingDirectory=/home/user/AI
Environment="PATH=/home/user/AI/venv/bin"
ExecStart=/home/user/AI/venv/bin/gunicorn -w 4 -b 0.0.0.0:5001 --access-logfile /var/log/asper-ai/access.log --error-logfile /var/log/asper-ai/error.log app:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
