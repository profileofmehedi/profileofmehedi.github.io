<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160" width="100%" height="100%">
  <defs>
    <linearGradient id="rotClock" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#8B5CF6"/><stop offset="100%" stop-color="#6D28D9"/></linearGradient>
    <filter id="shiftShad" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#6d28d9" flood-opacity="0.3"/></filter>
  </defs>
  <circle cx="80" cy="80" r="52" fill="none" stroke="#E2E8F0" stroke-width="8" stroke-linecap="round" filter="url(#shiftShad)"/>
  <circle cx="80" cy="80" r="52" fill="none" stroke="url(#rotClock)" stroke-width="8" stroke-dasharray="160 160" stroke-linecap="round"/>
  <circle cx="80" cy="80" r="32" fill="#0F172A" filter="url(#shiftShad)"/>
  <line x1="80" y1="80" x2="80" y2="60" stroke="#38BDF8" stroke-width="4" stroke-linecap="round"/>
  <line x1="80" y1="80" x2="94" y2="80" stroke="#FBBF24" stroke-width="4" stroke-linecap="round"/>
  <circle cx="80" cy="26" r="14" fill="#F59E0B" filter="url(#shiftShad)"/>
  <text x="80" y="31" fill="#ffffff" font-size="14" font-weight="bold" font-family="sans-serif" text-anchor="middle">☀</text>
  <circle cx="80" cy="134" r="14" fill="#3B82F6" filter="url(#shiftShad)"/>
  <text x="80" y="139" fill="#ffffff" font-size="13" font-weight="bold" font-family="sans-serif" text-anchor="middle">☾</text>
</svg>